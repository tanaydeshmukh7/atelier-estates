# ==============================================================================
# ATELIER ESTATES — ENVIRONMENT VARIABLES
# ==============================================================================
# In production, replace with your actual Supabase project credentials.
# The public key is safe for browser queries when protected by RLS.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Secret server-side service role key. Never expose this to the browser.
# Required by the server-side enquiry route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Transactional Email Notifications via Resend
# If set, incoming enquiries will automatically trigger notifications to the advisory desk.
# If unset, enquiries are saved securely in the Supabase database without email dispatch.
RESEND_API_KEY=re_your_api_key_here
ENQUIRY_NOTIFICATION_EMAIL=private@atelierestates.com
ENQUIRY_FROM_EMAIL=Atelier Estates <notifications@atelierestates.com>
